# Copy into the root .env of THIS worktree; never copy another worktree's secrets.
COMPOSE_PROJECT_NAME=mtn-splunk-codex
COMPOSE_FILE=mtn/deploy/compose.splunk-demo.yml:mtn/deploy/compose.splunk.yml
# Blank by design. Operator alone reviews terms and sets the acceptance flags in the guide.
SPLUNK_START_ARGS=
SPLUNK_GENERAL_TERMS=
SPLUNK_PASSWORD=
# Supplied AFTER configuring the app, role and service identity in Splunk Web.
MTN_SPLUNK_MCP_TOKEN=
# Separate HEC token, restricted to the three demo indexes; no admin credential.
MTN_SPLUNK_HEC_TOKEN=
# New demo credentials only; 32+ random characters for the Office token.
MTN_OFFICE_MCP_TOKEN=
GROQ_API_KEY=
# LibreChat auth encryption/session secrets; generate fresh, do not reuse another stack.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
APP_TITLE=MTN Employee AI
DOMAIN_CLIENT=http://localhost:3081
DOMAIN_SERVER=http://localhost:3081
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
SCHEDULES_SINGLE_PROCESS=true
DEPLOYMENT_SKILLS_DIR=/app/skill
SEARCH=false
