+/// Adds the outcome evidence as compact JSON with non-ASCII characters escaped (`\uXXXX`), so
+/// the value is header-safe and still valid JSON. Evidence that would exceed the routing-header
+/// limit is left out rather than truncated into invalid JSON.
+fn attach_evidence_header(response: &mut Response, evidence: &Value) {
+    let Ok(json) = serde_json::to_string(evidence) else {
+        return;
+    };
+    let mut ascii = String::with_capacity(json.len());
+    for ch in json.chars() {
+        if ch.is_ascii() && !ch.is_ascii_control() {
+            ascii.push(ch);
+        } else {
+            let mut units = [0u16; 2];
+            for unit in ch.encode_utf16(&mut units) {
+                ascii.push_str(&format!("\\u{unit:04x}"));
+            }
+        }
+    }
+    if ascii.len() > MAX_ROUTING_HEADER_VALUE_LEN {
+        return;
+    }
+    if let Ok(value) = HeaderValue::from_str(&ascii) {
+        response
+            .headers_mut()
+            .insert(HeaderName::from_static(HEADER_ROUTE_EVIDENCE), value);
+    }
+}
