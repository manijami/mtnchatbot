 /// Maps valid verdicts to scores, invalid verdicts to a reason, and leaves absent verdicts alone.
+/// Largest serialized custom verdict recorded as routing evidence.
+const MAX_CUSTOM_VERDICT_EVIDENCE_BYTES: usize = 1024;
+
+/// Records the validated custom-mode verdict as routing evidence, so a host can explain the
+/// choice (for example a short `reason` field defined in the route's own response schema).
+/// Oversized verdicts are summarized instead of copied. Judge failures keep the shared
+/// fail-open evidence.
+fn custom_evidence(_policy: &CustomPolicyRuntime, verdict: Option<&Value>) -> Option<Value> {
+    let verdict = verdict?;
+    let size = serde_json::to_string(verdict).map_or(usize::MAX, |text| text.len());
+    if size > MAX_CUSTOM_VERDICT_EVIDENCE_BYTES {
+        return Some(serde_json::json!({
+            "source": "llm-classifier",
+            "verdict_omitted": "too_large",
+        }));
+    }
+    Some(serde_json::json!({
+        "source": "llm-classifier",
+        "verdict": verdict,
+    }))
+}
