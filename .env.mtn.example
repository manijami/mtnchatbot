# MTN additions to .env (names and safe defaults only — never commit real values).
# Copy the upstream .env.example to .env first, then add these.

# --- Branding (Phase 1) ---
APP_TITLE=MTN Employee AI
CUSTOM_FOOTER="MTN Employee AI · AI can make mistakes. Verify important information."
HELP_AND_FAQ_URL=
ADMIN_PANEL_PORT=3001

# --- Local dev: single API replica, no Redis (Phase 3 replaces this with Redis streams) ---
SCHEDULES_SINGLE_PROCESS=true

# --- Model providers (DEV/TEST ONLY, synthetic data only; see CLAUDE.md Security) ---
GROQ_API_KEY=
NVIDIA_API_KEY=

# --- Phase 4: office-mcp ---
# Generate with: openssl rand -hex 32
MTN_OFFICE_MCP_TOKEN=
OFFICE_MCP_RETENTION_DAYS=0
OFFICE_MCP_PREVIEW_IMAGE=false
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:mtn/deploy/compose.office.yml:mtn/deploy/compose.rag-nvidia.yml:mtn/deploy/compose.router.yml

# --- Model router demo (mtn/deploy/compose.router.yml) — DEV/DEMO ONLY ---
SHOW_ROUTING_FOOTER=false
REDACT_PROMPTS=true

# --- Optional isolated Splunk demo (do not append to the shared stack's COMPOSE_FILE) ---
# Use mtn/splunk/.env.example in a NEW .env for this worktree instead.
# It selects compose.splunk-demo.yml + compose.splunk.yml and mtn-splunk-codex.
# Operator app download and licence acceptance: docs/mtn/splunk-integration.md.
