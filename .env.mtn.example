# MTN additions to .env (names and safe defaults only — never commit real values).
# Copy the upstream .env.example to .env first, then add these.

# --- Branding (Phase 1) ---
APP_TITLE=MTN Employee AI
CUSTOM_FOOTER=
HELP_AND_FAQ_URL=
ADMIN_PANEL_PORT=3001

# --- Local dev: single API replica, no Redis (Phase 3 replaces this with Redis streams) ---
SCHEDULES_SINGLE_PROCESS=true

# --- Model providers (DEV/TEST ONLY, synthetic data only; see CLAUDE.md Security) ---
GROQ_API_KEY=
NVIDIA_API_KEY=

# --- Phase 4: office-mcp ---
# Generate with: openssl rand -hex 32
MTN_OFFICE_MCP_TOKEN=
OFFICE_MCP_RETENTION_DAYS=0
OFFICE_MCP_PREVIEW_IMAGE=false
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:mtn/deploy/compose.office.yml:mtn/deploy/compose.rag-nvidia.yml
